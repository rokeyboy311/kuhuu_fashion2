# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database (PostgreSQL — used for BOTH app data AND image storage)
DATABASE_URL=postgresql://kuhuu_user:kuhuu_password@localhost:5432/kuhuu_fashion

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Kuhuu Fashion <noreply@kuhuufashion.com>

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Shiprocket
SHIPROCKET_EMAIL=your-shiprocket-email
SHIPROCKET_PASSWORD=your-shiprocket-password

# App
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
STORE_NAME=Kuhuu Fashion
SUPPORT_EMAIL=support@kuhuufashion.com
SUPPORT_PHONE=+91-XXXXXXXXXX

# NOTE: No Cloudinary keys needed!
# All images are stored directly in PostgreSQL as bytea (binary) columns.
# Images are processed with Sharp (resize + WebP conversion) before storage.
# Images are served via GET /api/v1/images/:id
